# ── Add these to your existing .env ───────────────────────────────
# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults shown)
CHATBOT_GEMINI_MODEL=gemini-2.5-flash
CHATBOT_EMBED_MODEL=all-MiniLM-L6-v2
CHATBOT_MAX_HISTORY_TURNS=10
CHATBOT_RETRY_DELAY_SECONDS=30
CHATBOT_LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call /api/chat/* in production.
# In DEBUG mode CORS is open for convenience.
CORS_ALLOWED_ORIGINS=https://axialfoundary.com,https://www.axialfoundary.com
