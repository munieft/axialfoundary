# ── Add these to your existing .env ───────────────────────────────
# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyA5SA0iGKLMRvJbS8FZQw6HMfyhAnQuqMM

# Optional overrides (defaults shown)
CHATBOT_GEMINI_MODEL=gemini-3.1-flash-lite-preview
CHATBOT_EMBED_MODEL=all-MiniLM-L6-v2
CHATBOT_MAX_HISTORY_TURNS=10
CHATBOT_RETRY_DELAY_SECONDS=30
